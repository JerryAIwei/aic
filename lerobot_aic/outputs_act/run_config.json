{
  "model": {
    "policy": "ACT (lerobot)",
    "reference": "https://github.com/huggingface/lerobot",
    "backbone": "ResNet-18 \u00d7 3 cameras",
    "dim_model": 256,
    "n_heads": 8,
    "n_enc_layers": 4,
    "n_dec_layers": 4,
    "chunk_size": 20,
    "n_action_steps": 10,
    "latent_dim": 32,
    "n_params": 28182278
  },
  "training": {
    "steps": 5000,
    "batch_size": 16,
    "lr": 1e-05,
    "weight_decay": 0.0001,
    "kl_weight": 10.0,
    "save_every": 5
  },
  "dataset": {
    "repo_id": "local/aic_cable_insertion_large",
    "n_train": 8500,
    "n_val": 1500,
    "cameras": [
      "center_camera",
      "left_camera",
      "right_camera"
    ]
  }
}